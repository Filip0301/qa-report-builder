# Copia este archivo como .env.local y completa con los datos del proyecto de Supabase
# (Dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave pública (publishable / anon). Es segura en el navegador SOLO si la tabla
# `reports` tiene RLS activado (ver supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-clave-publica>
# Alternativa con el nombre nuevo de Supabase (se usa si está definida):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
